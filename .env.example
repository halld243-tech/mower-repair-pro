# Database (PostgreSQL)
# For local development, use something like:
# postgresql://postgres:password@localhost:5432/lawn_mower_business
DATABASE_URL="postgresql://user:password@localhost:5432/lawn_mower_business"

# Email Service Configuration
# Use either SendGrid or Resend
SENDGRID_API_KEY="your_sendgrid_key_here"
# RESEND_API_KEY="your_resend_key_here"

# Owner contact for business notifications
OWNER_EMAIL="owner@enginerepairpro.com"

# Site Configuration
NEXT_PUBLIC_SITE_NAME="Engine Repair Pro"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
